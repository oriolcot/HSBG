# Copy to deploy.ps1 (ignored by Git). Requires PowerShell, Python, Node, Git and SSH.
# Commit reviewed changes first. This script never stages or commits files for you.
# Remote prerequisites: Bash, Python 3, curl, flock, timeout and noninteractive sudo
# permission to restart the configured service. Deploys code only, not dependencies.
$ErrorActionPreference = "Stop"
Set-Location $PSScriptRoot
if (Test-Path "$PSScriptRoot/.deploy.env") {
    Get-Content "$PSScriptRoot/.deploy.env" | ForEach-Object {
        if ($_ -match '^\s*(HSBG_SSH_TARGET|HSBG_REMOTE_PATH|HSBG_SERVICE_NAME)\s*=\s*(.*?)\s*$') {
            [Environment]::SetEnvironmentVariable($matches[1], $matches[2])
        }
    }
}
$target = $env:HSBG_SSH_TARGET
$remotePath = $env:HSBG_REMOTE_PATH
$service = $env:HSBG_SERVICE_NAME
if ($target -notmatch '^[a-zA-Z0-9][a-zA-Z0-9_.@-]*$' -or
    $remotePath -notmatch '^/[a-zA-Z0-9_./-]+$' -or
    $service -notmatch '^[a-zA-Z0-9_][a-zA-Z0-9_.@-]*$') {
    throw 'Set HSBG_SSH_TARGET, HSBG_REMOTE_PATH and HSBG_SERVICE_NAME in .deploy.env. Use a simple absolute remote path without spaces.'
}
$branch = git branch --show-current
if ($LASTEXITCODE -ne 0 -or $branch -ne 'main') { throw 'Deploy from main only.' }
$dirty = git status --porcelain --untracked-files=no
if ($LASTEXITCODE -ne 0 -or $dirty) { throw 'Commit reviewed changes before deploying.' }
python -m unittest discover -s tests
if ($LASTEXITCODE -ne 0) { throw 'Python tests failed.' }
node tests/test_history_ui.cjs
if ($LASTEXITCODE -ne 0) { throw 'Frontend tests failed.' }
$release = git rev-parse HEAD
if ($LASTEXITCODE -ne 0 -or $release -notmatch '^[0-9a-f]{40}$') { throw 'Cannot determine release commit.' }
git push origin main
if ($LASTEXITCODE -ne 0) { throw 'Push failed; server has not been changed.' }
# Recovery runs on the server, even if the client disconnects. Each network request
# and deployment operation has a deadline; failed recovery is reported explicitly.
$script = (Get-Content -Raw "$PSScriptRoot/scripts/deploy-remote.sh").Replace("`r", "")
$script | ssh -o BatchMode=yes -o ConnectTimeout=10 -o ServerAliveInterval=10 -o ServerAliveCountMax=3 $target "bash -s -- '$remotePath' '$service' '$release'"
if ($LASTEXITCODE -ne 0) { throw 'Deployment failed. Read the remote recovery result; do not assume the service was restored.' }
Write-Host "Deployment and health check succeeded: $release" -ForegroundColor Green
